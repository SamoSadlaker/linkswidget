{
    "name": "samosadlaker/linkswidget",
    "description": "A simple Control Panel dashboard widget for displaying quick links in Statamic.",
    "homepage": "https://github.com/SamoSadlaker/linkswidget",
    "keywords": ["statamic", "widget", "links", "dashboard", "control-panel"],
    "license": "MIT",
    "authors": [
        {
            "name": "SamoSadlaker",
            "email": "dev@samosadlaker.eu",
            "homepage": "https://samosadlaker.eu"
        }
    ],
    "support": {
        "email": "dev@samosadlaker.eu",
        "issues": "https://github.com/SamoSadlaker/linkswidget/issues",
        "source": "https://github.com/SamoSadlaker/linkswidget"
    },
    "autoload": {
        "psr-4": {
            "SamoSadlaker\\LinksWidget\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SamoSadlaker\\LinksWidget\\Tests\\": "tests"
        }
    },
    "require": {
        "statamic/cms": "^5.0 || ^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "statamic": {
            "name": "Linkswidget",
            "slug": "linkswidget",
            "description": "A simple Control Panel dashboard widget for displaying quick links in Statamic.",
            "developer": "SamoSadlaker",
            "developer-url": "https://samosadlaker.eu"
        },
        "laravel": {
            "providers": [
                "SamoSadlaker\\LinksWidget\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        },
        "non-feature-branches": ["master", "develop"]
    }
}
